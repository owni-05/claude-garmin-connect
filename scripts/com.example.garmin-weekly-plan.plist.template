<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.garmin-weekly-plan</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/claude-garmin-connect/scripts/weekly_plan.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/path/to/log/dir/claude-garmin-connect/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/log/dir/claude-garmin-connect/launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
